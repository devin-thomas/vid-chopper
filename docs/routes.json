{
  "canonicalOrigin": "https://vidchopper.app",
  "pagesBasePath": "/vid-chopper/",
  "delivery": {
    "htmlHandling": "drop-trailing-slash",
    "notFoundHandling": "404-page"
  },
  "htmlRoutes": [
    "/",
    "/docs",
    "/docs/getting-started",
    "/docs/cli",
    "/docs/chapterfiles",
    "/docs/embedded-chapters",
    "/docs/chapterbuilder",
    "/docs/dry-run-and-export",
    "/docs/manifests",
    "/docs/settings-and-failures",
    "/docs/safety",
    "/releases",
    "/features",
    "/download"
  ],
  "htmlTitles": {
    "/": "VidChopper | Local chapter clip export",
    "/docs": "Documentation | VidChopper",
    "/docs/getting-started": "Getting started | VidChopper Docs",
    "/docs/cli": "CLI invocation | VidChopper Docs",
    "/docs/chapterfiles": "ChapterFiles | VidChopper Docs",
    "/docs/embedded-chapters": "Embedded chapters | VidChopper Docs",
    "/docs/chapterbuilder": "ChapterBuilder handoff | VidChopper Docs",
    "/docs/dry-run-and-export": "Dry-run and confirmed export | VidChopper Docs",
    "/docs/manifests": "Manifest verification | VidChopper Docs",
    "/docs/settings-and-failures": "Settings and failures | VidChopper Docs",
    "/docs/safety": "Safety boundaries | VidChopper Docs",
    "/releases": "Releases | VidChopper",
    "/features": "Features | VidChopper",
    "/download": "Releases | VidChopper"
  },
  "legacyDocsRoutes": {
    "build-from-source": "/docs/getting-started",
    "architecture": "/docs",
    "coding-style": "/docs",
    "test-strategy": "/docs/manifests",
    "release-workflows": "/releases",
    "agent-knowledge-base": "/docs/safety"
