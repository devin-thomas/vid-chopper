{
  "name": "vidchopper-site",
  "private": true,
  "version": "1.1.0",
  "description": "Canonical VidChopper product, release, and CLI documentation site.",
  "homepage": "https://vidchopper.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devin-thomas/vid-chopper.git"
  },
  "bugs": {
    "url": "https://github.com/devin-thomas/vid-chopper/issues"
  },
  "type": "module",
  "scripts": {
    "stage:assets": "node scripts/stage-static-assets.mjs",
    "test": "npm run validate:architecture && npm run validate:shared-engine-guide && npm run validate:cpp20-guide && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dev": "npm run stage:assets && vite",
    "build": "npm run stage:assets && npm run typecheck && vite build && node scripts/finalize-routes.mjs && node scripts/validate-routes.mjs && node scripts/validate-cloudflare-deploy.mjs",
    "build:pages": "npm run stage:assets && npm run typecheck && vite build --mode pages && node scripts/finalize-routes.mjs --mode pages && node scripts/validate-routes.mjs --mode pages",
    "validate:architecture": "node scripts/validate-architecture-docs.mjs",
    "validate:shared-engine-guide": "node scripts/validate-shared-engine-guide.mjs",
    "validate:cpp20-guide": "node scripts/validate-cpp20-guide.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:cloudflare": "node scripts/validate-cloudflare-deploy.mjs",
    "cloudflare:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "npm run build && wrangler deploy --strict",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.120.1"
  }
}
